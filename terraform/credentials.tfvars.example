# Copy to credentials.tfvars and adjust. These are NON-secret tunables.
#
# The Hetzner API token is NOT set here — it is read from the environment as
# TF_VAR_hcloud_token (export HCLOUD_TOKEN and the control plane forwards it),
# so the secret never lands in a file or in git.

tenant_id           = "demo"
hcloud_server_type  = "cx22"
hcloud_location     = "nbg1"
ssh_public_key_path = "/Users/bogdishor/.ssh/id_ed25519.pub"
