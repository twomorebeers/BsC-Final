# Secrets & Terraform state (never commit)
terraform/credentials.tfvars
terraform/*.tfvars
!terraform/*.tfvars.example
*.tfstate
*.tfstate.*
terraform/terraform.tfstate.d/
terraform/.terraform/
terraform/.terraform.lock.hcl
*.auto.tfvars
.env
.env.*
!.env.example

